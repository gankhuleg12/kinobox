# ─────────────────────────────────────────────────────────────
#  KinoBox API — дэд бүтцийн тохиргоо
#  R2, Wire.mn, Google, Facebook, SMTP түлхүүрүүд ЭНД БИШ —
#  Admin Panel → API тохиргоо хэсгээс оруулна (DB-д шифрлэгдэж хадгалагдана).
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# Хэрэглэгчийн нээх frontend URL (OAuth redirect, email холбоос, FB товч)
APP_URL=http://localhost:5173
# Гаднаас хандах API URL (webhook, Google callback). Нэг домэйн дээр бол APP_URL-тэй ижил.
API_URL=http://localhost:5173
# Зөвшөөрөгдөх origin-ууд (таслалаар)
CORS_ORIGINS=http://localhost:5173
# Reverse proxy-ийн тоо (nginx/Cloudflare ард бол 1 эсвэл 2)
TRUST_PROXY=1

DATABASE_URL=mysql://kinobox:kinobox@localhost:3306/kinobox
REDIS_URL=redis://localhost:6379

# `openssl rand -base64 48` гэх мэтээр тус тусад нь үүсгэнэ
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_PLAYBACK_SECRET=change-me-playback-secret-at-least-32-characters
COOKIE_SECRET=change-me-cookie-secret-at-least-32-characters

# Admin тохиргооны secret-үүдийг шифрлэх мастер түлхүүр: `openssl rand -base64 32`
# ⚠️ Алдвал DB дэх secret-үүдийг тайлах боломжгүй болно. Аюулгүй газар нөөцлөөрэй.
SETTINGS_ENCRYPTION_KEY=ADFgnjoakert!@mdfasdf!@f-123mdsf

ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
PLAYBACK_TOKEN_TTL_SEC=21600

# Worker (видео transcode)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# TRANSCODE_TMP_DIR=/var/tmp/kinobox
TRANSCODE_CONCURRENCY=1

LOG_LEVEL=info

# Seed (npm run db:seed)
ADMIN_EMAIL=admin@kinobox.mn
ADMIN_PASSWORD=change-me-strong-password
SEED_SAMPLE_MOVIES=true
